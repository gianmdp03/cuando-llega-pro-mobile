{
  "expo": {
    "name": "Cuando Llega Pro",
    "slug": "cuando-llega-pro-mobile",
    "version": "1.0.0",
    "scheme": "cuando-llega-pro-mobile",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.gianmdp03.cuandollega",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#121212"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir acceso a la ubicación para ver paradas y colectivos cercanos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0088FF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-image",
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00409b54-8cbe-4737-99f1-069f5ca9e0bd"
      }
    },
    "owner": "gianmdp03"
  }
}
